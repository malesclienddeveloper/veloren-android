     Input(GameInput),
     /// Shows or hides the context grid.
     More,
+    /// Shows or hides the grid of less frequent actions.
+    Extra,
+    /// Switches the five skill buttons between slots 1-5 and 6-10.
+    SlotPage,
+}
+
+/// The inputs a button sends. A keyboard binds several actions to one key (Space
+/// is both jump and swim up, Shift is sneak, swim down and letting go of a
+/// wall), so a button has to send all of them.
+pub fn inputs(input: GameInput) -> impl Iterator<Item = GameInput> {
+    let companions: &[GameInput] = match input {
+        GameInput::Jump => &[GameInput::SwimUp, GameInput::WallJump],
+        GameInput::Sneak | GameInput::SwimDown => {
+            &[GameInput::SwimDown, GameInput::CancelClimb]
+        },
+        _ => &[],
+    };
+    std::iter::once(input).chain(companions.iter().copied().filter(move |&c| c != input))
 }
 
