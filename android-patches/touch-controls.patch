+/// Actions of the "Extra" grid, in slot order. The invitation answers come last
+/// so that the others do not move when an invitation arrives.
+const EXTRA_ACTIONS: [(GameInput, &str); 9] = [
+    (GameInput::Chat, "hud-touch-type"),
+    (GameInput::Crafting, "hud-touch-crafting"),
+    (GameInput::Social, "hud-touch-social"),
+    (GameInput::AutoWalk, "hud-touch-autowalk"),
+    (GameInput::ToggleWalk, "hud-touch-walk"),
+    (GameInput::CycleCamera, "hud-touch-camera"),
+    (GameInput::Select, "hud-touch-select"),
+    (GameInput::AcceptGroupInvite, "hud-touch-accept"),
+    (GameInput::DeclineGroupInvite, "hud-touch-decline"),
+];
+
+/// Left-hand lane of the buttons outside the menu and skill-slot lanes.
+const LANE_TOGGLE: f32 = 0.09;
+
+/// Widget slots of the buttons added after the respawn button.
+const SLOT_EXTRA_TOGGLE: usize = 1 + FIXED.len() + CONTEXT_SLOTS + DEATH_SLOTS;
+const SLOT_PAGE_TOGGLE: usize = SLOT_EXTRA_TOGGLE + 1;
+/// Give up while downed, or move down while swimming or climbing.
+const SLOT_STATE: usize = SLOT_PAGE_TOGGLE + 1;
+const SLOT_EXTRA_FIRST: usize = SLOT_STATE + 1;
+
 /// Total number of button slots; used to size the widget ids.
-pub const COUNT: usize = 1 + FIXED.len() + CONTEXT_SLOTS + DEATH_SLOTS;
+pub const COUNT: usize = SLOT_EXTRA_FIRST + EXTRA_ACTIONS.len();
+
+/// What the player has opened or switched on the overlay itself.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct View {
+    /// The "More" grid is open.
+    pub more: bool,
+    /// The "Extra" grid is open. Never together with `more`.
+    pub extra: bool,
+    /// The skill buttons act on slots 6-10.
+    pub second_slots: bool,
+}
+
+impl View {
+    pub fn toggle_more(&mut self) {
+        self.more = !self.more;
+        self.extra = false;
+    }
+
+    pub fn toggle_extra(&mut self) {
+        self.extra = !self.extra;
+        self.more = false;
+    }
+
+    pub fn toggle_slot_page(&mut self) { self.second_slots = !self.second_slots; }
+}
+
+/// The skill input and symbol that a slot button has on the second page.
+fn second_page(input: GameInput) -> Option<(GameInput, &'static str)> {
+    match input {
+        GameInput::Slot1 => Some((GameInput::Slot6, "6")),
+        GameInput::Slot2 => Some((GameInput::Slot7, "7")),
+        GameInput::Slot3 => Some((GameInput::Slot8, "8")),
+        GameInput::Slot4 => Some((GameInput::Slot9, "9")),
+        GameInput::Slot5 => Some((GameInput::Slot10, "10")),
+        _ => None,
+    }
+}
+
+/// Returns the buttons to show for the current state and overlay view.
+///
+/// `aspect` is the window width divided by its height.
+pub fn shown_in(
+    ctx: &Context,
+    view: View,
+    aspect: f32,
+    localize: impl Fn(&str) -> String,
+) -> Vec<Shown> {
+    let mut buttons = shown(ctx, view.more, aspect, &localize);
+    if view.second_slots {
+        for button in &mut buttons {
+            if let Some(Kind::Input(input)) = button.action
+                && let Some((input, symbol)) = second_page(input)
+            {
+                button.action = Some(Kind::Input(input));
+                button.label = symbol.to_owned();
+            }
+        }
+    }
+    if ctx.dead {
+        return buttons;
+    }
+    buttons.push(Shown {
+        index: SLOT_EXTRA_TOGGLE,
+        action: Some(Kind::Extra),
+        center: center_of(Side::Left, LANE_TOGGLE, ROW_MENU, aspect),
+        diameter: D_MENU,
+        label: localize(if view.extra {
+            "hud-touch-less"
+        } else {
+            "hud-touch-extra"
+        }),
+        active: view.extra,
+    });
+    buttons.push(Shown {
+        index: SLOT_PAGE_TOGGLE,
+        action: Some(Kind::SlotPage),
+        center: center_of(Side::Left, LANE_TOGGLE, ROW_SLOT, aspect),
+        diameter: D_SLOT,
+        label: if view.second_slots { "1-5" } else { "6-10" }.to_owned(),
+        active: view.second_slots,
+    });
+    let state_button = if !ctx.controlling || ctx.riding {
+        None
+    } else if ctx.downed {
+        Some((GameInput::GiveUp, "hud-touch-giveup"))
+    } else if ctx.swimming || ctx.climbing {
+        Some((GameInput::SwimDown, "hud-touch-down"))
+    } else {
+        None
+    };
+    if let Some((input, key)) = state_button {
+        let lane = if aspect < NARROW_GRID_MAX_ASPECT {
+            LANE_INNER_NARROW
+        } else {
+            LANE_INNER
+        };
+        buttons.push(Shown {
+            index: SLOT_STATE,
+            action: Some(Kind::Input(input)),
+            center: center_of(Side::Right, lane, ROW_HIGH, aspect),
+            diameter: D_SMALL,
+            label: localize(key),
+            active: false,
+        });
+    }
+    if view.extra {
+        for (slot, (input, key)) in EXTRA_ACTIONS.into_iter().enumerate() {
+            let invite_answer = matches!(
+                input,
+                GameInput::AcceptGroupInvite | GameInput::DeclineGroupInvite
+            );
+            if invite_answer && !ctx.has_invite {
+                continue;
+            }
+            let Some(placement) = context_slot(slot, true, aspect, EXPANDED_GRID_SLOTS) else {
+                continue;
+            };
+            buttons.push(Shown {
+                index: SLOT_EXTRA_FIRST + slot,
+                action: Some(Kind::Input(input)),
+                center: center_of(Side::Right, placement.lane, placement.row, aspect),
+                diameter: placement.diameter,
+                label: localize(key),
+                active: false,
+            });
+        }
+    }
+    buttons
+}
 
