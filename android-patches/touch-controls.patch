+    #[test]
+    fn added_buttons_do_not_overlap_or_leave_the_screen() {
+        for (name, ctx) in contexts() {
+            for aspect in ASPECTS {
+                for (more, extra, second_slots) in [
+                    (false, false, false),
+                    (true, false, true),
+                    (false, true, false),
+                    (false, true, true),
+                ] {
+                    let view = View {
+                        more,
+                        extra,
+                        second_slots,
+                    };
+                    let buttons: Vec<_> = shown_in(&ctx, view, aspect, str::to_owned)
+                        .into_iter()
+                        .map(|b| (b.index, b.center.x * aspect, b.center.y, b.diameter / 2.0))
+                        .collect();
+                    let state = format!("{name} at {aspect:.2} {view:?}");
+                    assert_apart(&buttons, &state);
+                    for (index, x, y, radius) in buttons {
+                        assert!(index < COUNT);
+                        assert!(x - radius >= 0.0 && x + radius <= aspect, "{index} {state}");
+                        assert!(y - radius >= 0.0 && y + radius <= 1.0, "{index} {state}");
+                    }
+                }
+            }
+        }
+    }
+
