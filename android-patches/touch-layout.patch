+/// Takes over graphics choices made in the launcher since the last start.
+#[cfg(target_os = "android")]
+fn apply_launcher_graphics(
+    launcher_dir: &std::path::Path,
+    config_dir: &std::path::Path,
+    settings: &mut Settings,
+) {
+    use crate::{launcher_config, render::ShadowMode, settings::Fps};
+
+    let choices = launcher_config::current().graphics;
+    if !launcher_config::graphics_pending(launcher_dir, &choices) {
+        return;
+    }
+    let graphics = &mut settings.graphics;
+    if let Some(factor) = choices.render_scale {
+        graphics.render_mode.upscale_mode.factor = factor;
+    }
+    if let Some(distance) = choices.view_distance {
+        graphics.terrain_view_distance = distance;
+        graphics.entity_view_distance = distance;
+    }
+    if let Some(fps) = choices.max_fps {
+        graphics.max_fps = Fps::Max(fps);
+    }
+    if let Some(shadows) = choices.shadows {
+        graphics.render_mode.shadow = if shadows {
+            ShadowMode::Cheap
+        } else {
+            ShadowMode::None
+        };
+    }
+    // Only remember the revision once the settings are safely on disk.
+    match settings.save_to_file(config_dir) {
+        Ok(()) => {
+            if let Err(error) = launcher_config::mark_graphics_applied(launcher_dir, &choices) {
+                warn!(?error, "Could not record the applied launcher graphics");
+            }
+        },
+        Err(error) => warn!(?error, "Could not save the launcher graphics"),
+    }
+}
