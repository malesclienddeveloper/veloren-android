+/// Like [`shown_in`], with the player's own choices from the launcher applied:
+/// buttons are moved, resized or hidden, context actions that were given a
+/// place stay on screen whenever they are available, and the stick can be
+/// swapped for a D-pad.
+pub fn shown_for(
+    ctx: &Context,
+    view: View,
+    aspect: f32,
+    config: &LauncherConfig,
+    localize: impl Fn(&str) -> String,
+) -> Vec<Shown> {
+    let pinned = |id: &str| config.buttons.contains_key(id);
+    let mut buttons = shown_pinned(ctx, view, aspect, &pinned, localize);
+    buttons.retain_mut(|button| match config.buttons.get(button.id) {
+        Some(placed) => {
+            button.center = anchored(placed, aspect);
+            button.diameter *= placed.scale;
+            placed.visible || always_visible(button.id)
+        },
+        None => true,
+    });
+    if view.more || view.extra {
+        // Placed buttons that an open grid would cover step aside until it is
+        // closed again.
+        let grid: Vec<(Vec2<f32>, f32)> = buttons
+            .iter()
+            .filter(|button| {
+                (is_context_slot(button.index) || is_extra_slot(button.index))
+                    && !config.buttons.contains_key(button.id)
+            })
+            .map(|button| (button.center, button.diameter))
+            .collect();
+        buttons.retain(|button| {
+            !config.buttons.contains_key(button.id)
+                || matches!(button.id, "move" | "menu" | "more" | "extra")
+                || !grid.iter().any(|&(center, diameter)| {
+                    let reach = (diameter + button.diameter) / 2.0;
+                    (center.x - button.center.x).abs() * aspect < reach
+                        && (center.y - button.center.y).abs() < reach
