diff --git a/voxygen/src/launcher_config.rs b/voxygen/src/launcher_config.rs
new file mode 100644
index 00000000..241a25b8
--- /dev/null
+++ b/voxygen/src/launcher_config.rs
@@ -0,0 +1,228 @@
+//! Choices made in the Android launcher, read once when the game starts.
+//!
+//! The launcher writes `<app files>/launcher/config.txt` as `key=value` lines:
+//!
+//! ```text
+//! movement=joystick            (or dpad)
+//! opacity=1.0
+//! button.jump=R,0.14,0.78,1.0,1   (anchor, offset, row, scale, visible)
+//! perf.revision=3
+//! perf.render_scale=0.5
+//! ```
+//!
+//! Offsets and rows are fractions of the screen height; the anchor says whether
+//! the offset counts from the left edge, the centre or the right edge. Lines
+//! that are missing or invalid leave the game's own behaviour in place.
+
+use std::{collections::HashMap, path::Path, sync::OnceLock};
+
+/// Folder below the app's files directory that the launcher owns.
+pub const DIR: &str = "launcher";
+/// Merged contents of the enabled resource packs, used as asset override.
+pub const OVERRIDE_DIR: &str = "override";
+const CONFIG_FILE: &str = "config.txt";
+const APPLIED_FILE: &str = "graphics-applied.txt";
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Anchor {
+    Left,
+    Center,
+    Right,
+}
+
+/// Where the player put one button.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Placed {
+    pub anchor: Anchor,
+    pub offset: f32,
+    pub row: f32,
+    pub scale: f32,
+    pub visible: bool,
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Movement {
+    #[default]
+    Joystick,
+    Dpad,
+}
+
+/// Graphics choices. They are applied once per `revision`, so that changes made
+/// in the in-game settings afterwards are kept.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Graphics {
+    pub revision: u64,
+    pub render_scale: Option<f32>,
+    pub view_distance: Option<u32>,
+    pub max_fps: Option<u32>,
+    pub shadows: Option<bool>,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct LauncherConfig {
+    pub movement: Movement,
+    /// Multiplies the transparency of the touch controls.
+    pub opacity: f32,
+    pub buttons: HashMap<String, Placed>,
+    pub graphics: Graphics,
+}
+
+impl Default for LauncherConfig {
+    fn default() -> Self {
+        Self {
+            movement: Movement::Joystick,
+            opacity: 1.0,
+            buttons: HashMap::new(),
+            graphics: Graphics::default(),
+        }
+    }
+}
+
+/// A finite number clamped into `min..=max`.
+fn number(text: &str, min: f32, max: f32) -> Option<f32> {
+    text.trim()
+        .parse::<f32>()
+        .ok()
+        .filter(|value| value.is_finite())
+        .map(|value| value.clamp(min, max))
+}
+
+fn placed(text: &str) -> Option<Placed> {
+    let mut parts = text.split(',').map(str::trim);
+    let anchor = match parts.next()? {
+        "L" => Anchor::Left,
+        "C" => Anchor::Center,
+        "R" => Anchor::Right,
+        _ => return None,
+    };
+    let offset = number(parts.next()?, -3.0, 3.0)?;
+    let row = number(parts.next()?, 0.0, 1.0)?;
+    let scale = number(parts.next()?, 0.5, 2.0)?;
+    let visible = parts.next()? != "0";
+    Some(Placed {
+        anchor,
+        offset,
+        row,
+        scale,
+        visible,
+    })
+}
+
+impl LauncherConfig {
+    pub fn parse(text: &str) -> Self {
+        let mut config = Self::default();
+        for line in text.lines() {
+            let Some((key, value)) = line.split_once('=') else {
+                continue;
+            };
+            let (key, value) = (key.trim(), value.trim());
+            if let Some(id) = key.strip_prefix("button.") {
+                if let Some(placed) = placed(value) {
+                    config.buttons.insert(id.to_owned(), placed);
+                }
+                continue;
+            }
+            let graphics = &mut config.graphics;
+            match key {
+                "movement" if value == "dpad" => config.movement = Movement::Dpad,
+                "opacity" => config.opacity = number(value, 0.2, 1.0).unwrap_or(1.0),
+                "perf.revision" => graphics.revision = value.parse().unwrap_or(0),
+                "perf.render_scale" => graphics.render_scale = number(value, 0.25, 1.0),
+                "perf.view_distance" => {
+                    graphics.view_distance = value.parse().ok().map(|v: u32| v.clamp(1, 32));
+                },
+                "perf.max_fps" => {
+                    graphics.max_fps = value.parse().ok().map(|v: u32| v.clamp(15, 120));
+                },
+                "perf.shadows" => graphics.shadows = Some(value != "0"),
+                _ => {},
+            }
+        }
+        config
+    }
+}
+
+static CURRENT: OnceLock<LauncherConfig> = OnceLock::new();
+
+/// Reads the launcher's file from `dir`. Only the first call has an effect.
+pub fn load(dir: &Path) {
+    let text = std::fs::read_to_string(dir.join(CONFIG_FILE)).unwrap_or_default();
+    let _ = CURRENT.set(LauncherConfig::parse(&text));
+}
+
+/// The loaded choices, or the defaults when there is no launcher.
+pub fn current() -> &'static LauncherConfig { CURRENT.get_or_init(LauncherConfig::default) }
+
+/// Whether the graphics choices in `dir` still have to be applied.
+pub fn graphics_pending(dir: &Path, graphics: &Graphics) -> bool {
+    graphics.revision != 0
+        && std::fs::read_to_string(dir.join(APPLIED_FILE))
+            .ok()
+            .and_then(|text| text.trim().parse::<u64>().ok())
+            != Some(graphics.revision)
+}
+
+/// Remembers that this revision of the graphics choices has been applied.
+pub fn mark_graphics_applied(dir: &Path, graphics: &Graphics) -> std::io::Result<()> {
+    std::fs::write(dir.join(APPLIED_FILE), graphics.revision.to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_a_launcher_file() {
+        let config = LauncherConfig::parse(
+            "# comment\nmovement=dpad\nopacity=0.5\nbutton.jump=R,0.14,0.78,1.5,1\n\
+             button.diary=C,-0.24,0.09,1,0\nperf.revision=7\nperf.render_scale=0.65\n\
+             perf.view_distance=6\nperf.max_fps=45\nperf.shadows=0\n",
+        );
+        assert_eq!(config.movement, Movement::Dpad);
+        assert_eq!(config.opacity, 0.5);
+        assert_eq!(config.buttons["jump"], Placed {
+            anchor: Anchor::Right,
+            offset: 0.14,
+            row: 0.78,
+            scale: 1.5,
+            visible: true,
+        });
+        assert!(!config.buttons["diary"].visible);
+        assert_eq!(config.graphics, Graphics {
+            revision: 7,
+            render_scale: Some(0.65),
+            view_distance: Some(6),
+            max_fps: Some(45),
+            shadows: Some(false),
+        });
+    }
+
+    #[test]
+    fn invalid_lines_are_ignored_or_clamped() {
+        let config = LauncherConfig::parse(
+            "button.a=Q,1,1,1,1\nbutton.b=L,NaN,0.5,1,1\nbutton.c=L,0.1\n\
+             button.d=L,99,7,99,1\nopacity=abc\nperf.max_fps=100000\nnonsense\n",
+        );
+        assert_eq!(config.buttons.len(), 1);
+        let d = config.buttons["d"];
+        assert_eq!((d.offset, d.row, d.scale), (3.0, 1.0, 2.0));
+        assert_eq!(config.opacity, 1.0);
+        assert_eq!(config.graphics.max_fps, Some(120));
+        assert_eq!(LauncherConfig::parse(""), LauncherConfig::default());
+    }
+
+    #[test]
+    fn graphics_apply_once_per_revision() {
+        let dir = std::env::temp_dir().join(format!("launcher-config-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let mut graphics = Graphics::default();
+        assert!(!graphics_pending(&dir, &graphics));
+        graphics.revision = 2;
+        assert!(graphics_pending(&dir, &graphics));
+        mark_graphics_applied(&dir, &graphics).unwrap();
+        assert!(!graphics_pending(&dir, &graphics));
+        graphics.revision = 3;
+        assert!(graphics_pending(&dir, &graphics));
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+}
