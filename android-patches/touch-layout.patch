+/// Screen position of a button the player placed.
+fn anchored(placed: &Placed, aspect: f32) -> Vec2<f32> {
+    let aspect = aspect.max(0.1);
+    let x = match placed.anchor {
+        Anchor::Left => placed.offset / aspect,
+        Anchor::Center => 0.5 + placed.offset / aspect,
+        Anchor::Right => 1.0 - placed.offset / aspect,
+    };
+    // Keep the centre on screen whatever the shape of this device.
+    Vec2::new(x.clamp(0.0, 1.0), placed.row)
+}
