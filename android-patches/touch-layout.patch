+/// The part of the screen that steers the character.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct MoveZone {
+    /// Centre as fractions of the screen.
+    pub center: Vec2<f32>,
+    /// Half-side length as a fraction of the screen height.
+    pub half_extent: f32,
+    pub mode: Movement,
+    /// Set when the player moved the control or uses the D-pad. Otherwise the
+    /// whole lower left of the screen steers.
+    pub custom: bool,
+}
+
+impl MoveZone {
+    /// Whether a touch starting at `position` steers.
+    pub fn claims(&self, position: Vec2<f32>, width: f32, height: f32) -> bool {
+        if !self.custom {
+            return position.x < width * 0.42 && position.y > height * 0.32;
+        }
+        let delta = position - Vec2::new(self.center.x * width, self.center.y * height);
+        let half = self.half_extent * height;
+        delta.x.abs() <= half && delta.y.abs() <= half
+    }
+}
+
+/// Where movement touches go, or `None` when the character cannot move.
+pub fn move_zone(ctx: &Context, aspect: f32, config: &LauncherConfig) -> Option<MoveZone> {
+    if ctx.dead {
+        return None;
+    }
+    let placed = config.buttons.get("move");
+    let center = placed.map_or(Vec2::new(STICK_X, STICK_Y), |p| anchored(p, aspect));
+    let diameter = D_STICK * placed.map_or(1.0, |p| p.scale);
+    let half_extent = match config.movement {
+        // A little margin around the arrows.
+        Movement::Dpad => diameter * 0.55,
+        // A floating stick may be grabbed somewhat outside its picture.
+        Movement::Joystick => diameter * 0.8,
+    };
+    Some(MoveZone {
+        center,
+        half_extent,
+        mode: config.movement,
+        custom: placed.is_some() || config.movement == Movement::Dpad,
+    })
+}
