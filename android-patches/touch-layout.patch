+        let stick = buttons.remove(stick);
+        for (offset, (name, x, y, label)) in DPAD.into_iter().enumerate() {
+            let distance = stick.diameter * DPAD_OFFSET;
+            buttons.push(Shown {
+                index: SLOT_DPAD_FIRST + offset,
+                id: name,
+                icon: name,
+                action: None,
+                center: stick.center
+                    + Vec2::new(x * distance / aspect.max(0.1), y * distance),
+                diameter: stick.diameter * DPAD_ARROW,
+                label: label.to_owned(),
+                active: false,
+            });
+        }
+    }
