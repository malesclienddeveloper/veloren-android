+/// Movement for a finger at `offset` from the middle of the D-pad (screen
+/// coordinates), in game axes (x right, y forward). Snaps to eight directions.
+pub fn dpad_axis(offset: Vec2<f32>, radius: f32) -> Vec2<f32> {
+    if offset.magnitude() < radius * 0.15 {
+        return Vec2::zero();
+    }
+    let step = std::f32::consts::FRAC_PI_4;
+    let angle = ((-offset.y).atan2(offset.x) / step).round() * step;
+    let snap = |value: f32| if value.abs() < 0.1 { 0.0 } else { value };
+    Vec2::new(snap(angle.cos()), snap(angle.sin()))
+}
