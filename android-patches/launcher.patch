+package net.veloren.android;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.app.DownloadManager;
+import android.content.ActivityNotFoundException;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.Signature;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.Environment;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.OpenableColumns;
+import android.provider.Settings;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.Button;
+import android.widget.CheckBox;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.ProgressBar;
+import android.widget.ScrollView;
+import android.widget.SeekBar;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * First screen of the app: checks for updates, holds the player's choices (controls,
+ * resource packs, graphics) and starts the game.
+ */
+public class LauncherActivity extends Activity {
+    /** The weekly tag of the official repository is what the official server runs. */
+    private static final String OFFICIAL_WEEKLY_URL =
+            "https://gitlab.com/api/v4/projects/veloren%2Fveloren/repository/tags/weekly";
+    private static final String APK_MIME = "application/vnd.android.package-archive";
+    private static final String PREF_ID = "downloadId";
+    private static final String PREF_CODE = "downloadCode";
+    private static final String PREF_SHA = "downloadSha";
+    private static final int AUTO_START_SECONDS = 3;
+    private static final long SPARE_BYTES = 200L * 1024 * 1024;
+    private static final int PICK_PACK = 1;
+    private static final String[] PAGES = {"Main", "Kontrol", "Resource Pack", "Grafis"};
+
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private TextView status;
+    private TextView detail;
+    private ProgressBar progress;
+    private LinearLayout buttons;
+    private SharedPreferences prefs;
+    private DownloadManager downloads;
+
+    private String repo;
+    private String installedCommit;
+    private String installedSigner;
+    private long installedCode;
+
+    /** Incremented to make results of older background work irrelevant. */
+    private int generation;
+    private boolean resumed;
+    /** Countdown or download poll; only runs while the screen is in front. */
+    private Runnable ticker;
+    private boolean countingDown;
+    private int secondsLeft;
+
+    private File launcherDirectory;
+    private LauncherConfig config;
+    private ResourcePacks packs;
+    /** Set while resource packs are being changed in the background. */
+    private boolean packsBusy;
+
+    private View home;
+    private ControlEditor editor;
+    private final View[] pages = new View[PAGES.length];
+    private final Button[] tabs = new Button[PAGES.length];
+    private LinearLayout controlsPage;
+    private LinearLayout packsPage;
+    private LinearLayout graphicsPage;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        // Tapping the app icon while the game is open must return to the game.
+        if (!isTaskRoot() && Intent.ACTION_MAIN.equals(getIntent().getAction())) {
+            finish();
+            return;
+        }
+
+        prefs = getSharedPreferences("launcher", MODE_PRIVATE);
+        downloads = (DownloadManager) getSystemService(Context.DOWNLOAD_SERVICE);
+        repo = getString(R.string.launcher_release_repo);
+        installedCommit = getString(R.string.launcher_upstream_commit);
+        installedCode = readInstalledCode();
+        installedSigner = readInstalledSigner();
+        launcherDirectory = new File(getFilesDir(), "launcher");
+        config = LauncherConfig.load(launcherDirectory);
+        saveConfig();
+        packs = new ResourcePacks(launcherDirectory);
+        buildLayout();
+        showPage(0);
+
+        // The downloaded APK is large: delete it once it has been installed.
+        long downloaded = prefs.getLong(PREF_CODE, 0);
+        if (downloaded != 0 && installedCode >= downloaded) {
+            forgetDownload();
+        }
+        checkForUpdate();
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        resumed = true;
+        secondsLeft = AUTO_START_SECONDS;
+        if (ticker != null) {
+            handler.post(ticker);
+        }
+    }
+
+    @Override
+    protected void onPause() {
+        resumed = false;
+        handler.removeCallbacksAndMessages(null);
+        super.onPause();
+    }
+
+    @Override
+    protected void onDestroy() {
+        generation++;
+        handler.removeCallbacksAndMessages(null);
+        super.onDestroy();
+    }
+
+    @Override
+    @SuppressWarnings("deprecation")
+    public void onBackPressed() {
+        if (editor != null) {
+            closeEditor();
+        } else if (pages[0] != null && pages[0].getVisibility() != View.VISIBLE) {
+            showPage(0);
+        } else {
+            super.onBackPressed();
+        }
+    }
+
+    private void setTicker(Runnable next) {
+        handler.removeCallbacksAndMessages(null);
+        countingDown = false;
+        ticker = next;
+        if (resumed && next != null) {
+            handler.post(next);
+        }
+    }
+
+    private void startGame() {
+        if (packsBusy) {
+            toast("Tunggu, resource pack sedang disiapkan.");
+            return;
+        }
+        if (!saveConfig()) {
+            return;
+        }
+        generation++;
+        setTicker(null);
+        startActivity(new Intent(this, VelorenGameActivity.class));
+        finish();
+    }
+
+    private boolean saveConfig() {
+        try {
+            config.save(launcherDirectory);
+            return true;
+        } catch (IOException e) {
+            toast("Pengaturan tidak bisa disimpan: " + e.getMessage());
+            return false;
+        }
+    }
+
+    private void toast(String message) {
+        Toast.makeText(this, message, Toast.LENGTH_LONG).show();
+    }
+
+    // Layout
+
+    private void buildLayout() {
+        LinearLayout root = Widgets.row(this);
+        root.setBackgroundColor(Widgets.BACKGROUND);
+
+        LinearLayout sidebar = Widgets.column(this);
+        sidebar.setBackgroundColor(Widgets.SIDEBAR);
+        sidebar.setPadding(dp(10), dp(14), dp(10), dp(10));
+        TextView title = Widgets.text(this, "VELOREN", 22, Widgets.TEXT);
+        title.setGravity(Gravity.CENTER);
+        title.setLetterSpacing(0.15f);
+        Widgets.addWide(sidebar, title);
+        for (int index = 0; index < PAGES.length; index++) {
+            final int page = index;
+            tabs[index] = Widgets.button(this, PAGES[index], () -> {
+                stopCountdown();
+                showPage(page);
+            });
+            Widgets.addWide(sidebar, tabs[index]);
+        }
+        ScrollView sideScroll = new ScrollView(this);
+        sideScroll.setFillViewport(true);
+        sideScroll.setBackgroundColor(Widgets.SIDEBAR);
+        sideScroll.addView(sidebar);
+        root.addView(sideScroll,
