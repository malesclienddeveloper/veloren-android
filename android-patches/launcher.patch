index 00000000..1c333d22
--- /dev/null
+++ b/android/app/src/main/java/net/veloren/android/LauncherConfig.java
@@ -0,0 +1,316 @@
+package net.veloren.android;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * The player's choices, stored in {@code launcher/config.txt}. The game reads the same
+ * file (voxygen/src/launcher_config.rs). Free of Android classes so it can be tested.
+ */
+final class LauncherConfig {
+    static final String FILE = "config.txt";
+    static final String LAYOUT_MINECRAFT = "minecraft";
+    static final String LAYOUT_ORIGINAL = "asli";
+    static final String LAYOUT_CUSTOM = "kustom";
+
+    /** Where a button is: anchor L, C or R, offset and row in screen heights. */
+    static final class Spot {
+        char anchor;
+        float offset;
+        float row;
+        float scale;
+        boolean visible;
+
+        Spot(char anchor, float offset, float row, float scale, boolean visible) {
+            this.anchor = anchor;
+            this.offset = offset;
+            this.row = row;
+            this.scale = scale;
+            this.visible = visible;
+        }
+
+        float x(float width, float height) {
+            float x = anchor == 'L' ? offset * height
+                    : anchor == 'R' ? width - offset * height
+                    : width / 2 + offset * height;
+            return clamp(x, 0, width);
+        }
+
+        float y(float height) {
+            return row * height;
+        }
+
+        /** Moves to a point on screen, anchored to whichever third it lies in. */
+        void moveTo(float x, float y, float width, float height) {
+            x = clamp(x, 0, width);
+            if (x < width / 3) {
+                anchor = 'L';
+                offset = x / height;
+            } else if (x > width * 2 / 3) {
+                anchor = 'R';
+                offset = (width - x) / height;
+            } else {
+                anchor = 'C';
+                offset = (x - width / 2) / height;
+            }
+            row = clamp(y / height, 0, 1);
+        }
+    }
+
+    /** One button the game can show. Names and sizes match touch_buttons.rs. */
+    static final class Button {
+        final String id;
+        final String label;
+        /** Diameter as a fraction of the screen height. */
+        final float diameter;
+        /** Only shown when it applies; unless placed, it lives in a grid of the game. */
+        final boolean optional;
+
+        private Button(String id, String label, float diameter, boolean optional) {
+            this.id = id;
+            this.label = label;
+            this.diameter = diameter;
+            this.optional = optional;
+        }
+    }
+
+    static final Map<String, Button> BUTTONS;
+
+    static {
+        Map<String, Button> all = new LinkedHashMap<>();
+        fixed(all, "move", "Gerak", 0.30f);
+        fixed(all, "attack", "Serang", 0.18f);
+        fixed(all, "jump", "Lompat", 0.13f);
+        fixed(all, "alt", "Alt", 0.13f);
+        fixed(all, "roll", "Guling", 0.13f);
+        fixed(all, "interact", "Aksi", 0.13f);
+        fixed(all, "state", "Turun", 0.13f);
+        fixed(all, "inventory", "Tas", 0.085f);
+        fixed(all, "diary", "Diari", 0.085f);
+        fixed(all, "menu", "Menu", 0.085f);
+        fixed(all, "more", "Lain", 0.085f);
+        fixed(all, "extra", "Ekstra", 0.085f);
+        for (int slot = 1; slot <= 5; slot++) {
+            fixed(all, "slot" + slot, String.valueOf(slot), 0.089f);
+        }
+        fixed(all, "slotpage", "6-10", 0.089f);
+        String[][] optional = {
+            {"sneak", "Jongkok"}, {"chat", "Chat"}, {"map", "Peta"}, {"swap", "Ganti"},
+            {"draw", "Senjata"}, {"block", "Tangkis"}, {"lantern", "Lampu"},
+            {"glide", "Terbang"}, {"mount", "Naik"}, {"trade", "Dagang"}, {"stay", "Diam"},
+            {"sit", "Duduk"}, {"crawl", "Rayap"}, {"dance", "Joget"}, {"greet", "Sapa"},
+            {"zoomin", "Zoom +"}, {"zoomout", "Zoom -"}, {"zoomlock", "Kunci zoom"},
+            {"type", "Ketik"}, {"crafting", "Craft"}, {"social", "Sosial"},
+            {"autowalk", "Jalan auto"}, {"walk", "Pelan"}, {"camera", "Kamera"},
+            {"select", "Target"}, {"accept", "Terima"}, {"decline", "Tolak"},
+        };
+        for (String[] entry : optional) {
+            all.put(entry[0], new Button(entry[0], entry[1], 0.13f, true));
+        }
+        BUTTONS = Collections.unmodifiableMap(all);
+    }
+
+    private static void fixed(Map<String, Button> all, String id, String label, float size) {
+        all.put(id, new Button(id, label, size, false));
+    }
+
+    /** Buttons that must stay on screen. */
+    static boolean canHide(String id) {
+        return !id.equals("move") && !id.equals("menu");
+    }
+
+    String layout = LAYOUT_MINECRAFT;
+    boolean dpad;
+    float opacity = 1;
+    boolean autoStart = true;
+    final Map<String, Spot> spots = new LinkedHashMap<>();
+
+    /** 0 leaves the graphics to the in-game settings. */
+    long graphicsRevision;
+    float renderScale = 0.5f;
+    int viewDistance = 5;
+    int maxFps = 30;
+    boolean shadows = true;
+
+    /** A fresh configuration: the Minecraft-like layout. */
+    static LauncherConfig defaults() {
+        LauncherConfig config = new LauncherConfig();
+        config.useMinecraftLayout();
+        return config;
+    }
+
+    /**
+     * Movement bottom left, jump and actions bottom right, hotbar along the bottom and
+     * menus along the top, as in the touch versions of block games.
+     */
+    void useMinecraftLayout() {
+        layout = LAYOUT_MINECRAFT;
+        spots.clear();
+        put("move", 'L', 0.22f, 0.74f, 1);
+        put("jump", 'R', 0.15f, 0.78f, 1.2f);
+        put("attack", 'R', 0.15f, 0.55f, 1);
+        put("interact", 'R', 0.15f, 0.32f, 1);
+        put("sneak", 'R', 0.37f, 0.84f, 1);
+        put("alt", 'R', 0.38f, 0.66f, 1);
+        put("roll", 'R', 0.38f, 0.46f, 1);
+        put("state", 'R', 0.38f, 0.28f, 1);
+        put("diary", 'C', -0.24f, 0.09f, 1);
+        // Optional buttons are larger; scaled to the size of the other menu buttons.
+        put("chat", 'C', -0.12f, 0.09f, 0.65f);
+        put("menu", 'C', 0, 0.09f, 1);
+        put("extra", 'C', 0.12f, 0.09f, 1);
+        put("more", 'C', 0.24f, 0.09f, 1);
+        put("inventory", 'C', -0.34f, 0.925f, 1);
+        for (int slot = 1; slot <= 5; slot++) {
+            put("slot" + slot, 'C', (slot - 3) * 0.11f, 0.925f, 1);
+        }
+        put("slotpage", 'C', 0.34f, 0.925f, 1);
+    }
+
+    /** The layout the Android port ships with. */
+    void useOriginalLayout() {
+        layout = LAYOUT_ORIGINAL;
+        spots.clear();
+    }
+
+    private void put(String id, char anchor, float offset, float row, float scale) {
+        spots.put(id, new Spot(anchor, offset, row, scale, true));
+    }
+
+    String serialize() {
+        StringBuilder text = new StringBuilder("# Ditulis oleh launcher Veloren\n");
+        line(text, "layout", layout);
+        line(text, "autostart", autoStart ? "1" : "0");
+        line(text, "movement", dpad ? "dpad" : "joystick");
+        line(text, "opacity", decimal(opacity));
+        for (Map.Entry<String, Spot> entry : spots.entrySet()) {
+            Spot spot = entry.getValue();
+            line(text, "button." + entry.getKey(), spot.anchor + "," + decimal(spot.offset)
+                    + "," + decimal(spot.row) + "," + decimal(spot.scale) + ","
+                    + (spot.visible ? "1" : "0"));
+        }
+        if (graphicsRevision != 0) {
+            line(text, "perf.revision", String.valueOf(graphicsRevision));
+            line(text, "perf.render_scale", decimal(renderScale));
+            line(text, "perf.view_distance", String.valueOf(viewDistance));
+            line(text, "perf.max_fps", String.valueOf(maxFps));
+            line(text, "perf.shadows", shadows ? "1" : "0");
+        }
+        return text.toString();
+    }
+
+    /** Reads a stored file; anything missing or invalid keeps its default. */
+    static LauncherConfig parse(String text) {
+        LauncherConfig config = new LauncherConfig();
+        for (String line : text.split("\n")) {
+            int split = line.indexOf('=');
+            if (split < 0 || line.startsWith("#")) {
+                continue;
+            }
+            String key = line.substring(0, split).trim();
+            String value = line.substring(split + 1).trim();
+            try {
+                if (key.startsWith("button.")) {
+                    String[] parts = value.split(",");
+                    if (parts.length != 5 || !parts[0].matches("[LCR]")) {
+                        continue;
+                    }
+                    config.spots.put(key.substring("button.".length()), new Spot(
+                            parts[0].charAt(0), finite(parts[1], -3, 3), finite(parts[2], 0, 1),
+                            finite(parts[3], 0.5f, 2), !parts[4].equals("0")));
+                    continue;
+                }
+                switch (key) {
+                    case "layout":
+                        config.layout = value;
+                        break;
+                    case "autostart":
+                        config.autoStart = !value.equals("0");
+                        break;
+                    case "movement":
+                        config.dpad = value.equals("dpad");
+                        break;
+                    case "opacity":
+                        config.opacity = finite(value, 0.2f, 1);
+                        break;
+                    case "perf.revision":
+                        config.graphicsRevision = Long.parseLong(value);
+                        break;
+                    case "perf.render_scale":
+                        config.renderScale = finite(value, 0.25f, 1);
+                        break;
+                    case "perf.view_distance":
+                        config.viewDistance = Integer.parseInt(value);
+                        break;
+                    case "perf.max_fps":
+                        config.maxFps = Integer.parseInt(value);
+                        break;
+                    case "perf.shadows":
+                        config.shadows = !value.equals("0");
+                        break;
+                    default:
+                        break;
+                }
+            } catch (NumberFormatException e) {
+                // Keep the default for this line.
+            }
+        }
+        return config;
+    }
+
+    /** Loads from {@code directory}, falling back to the defaults. */
+    static LauncherConfig load(File directory) {
+        File file = new File(directory, FILE);
+        if (!file.isFile()) {
+            return defaults();
+        }
+        try {
+            return parse(new String(Files.read(file), StandardCharsets.UTF_8));
+        } catch (IOException e) {
+            return defaults();
+        }
+    }
+
+    void save(File directory) throws IOException {
+        Files.writeAtomically(new File(directory, FILE),
+                serialize().getBytes(StandardCharsets.UTF_8));
+    }
+
+    /** Optional buttons that have not been placed yet. */
+    List<Button> unplaced() {
+        List<Button> missing = new ArrayList<>();
+        for (Button button : BUTTONS.values()) {
+            if (!spots.containsKey(button.id)) {
+                missing.add(button);
+            }
+        }
+        return missing;
+    }
+
+    private static void line(StringBuilder text, String key, String value) {
+        text.append(key).append('=').append(value).append('\n');
+    }
+
+    private static String decimal(float value) {
+        return String.format(Locale.ROOT, "%.4f", value);
+    }
+
+    private static float finite(String text, float min, float max) {
+        float value = Float.parseFloat(text.trim());
+        if (Float.isNaN(value) || Float.isInfinite(value)) {
+            throw new NumberFormatException(text);
+        }
+        return clamp(value, min, max);
+    }
+
+    static float clamp(float value, float min, float max) {
+        return Math.max(min, Math.min(max, value));
+    }
+}
diff --git a/android/app/src/main/java/net/veloren/android/ResourcePacks.java b/android/app/src/main/java/net/veloren/android/ResourcePacks.java
