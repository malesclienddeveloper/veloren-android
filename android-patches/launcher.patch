+++ b/android/app/src/main/java/net/veloren/android/ControlEditor.java
@@ -0,0 +1,282 @@
+package net.veloren.android;
+
+import android.annotation.SuppressLint;
+import android.app.AlertDialog;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.view.Gravity;
+import android.view.MotionEvent;
+import android.view.View;
+import android.widget.Button;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import java.util.List;
+import java.util.Map;
+
+/** Full-screen editor: drag the touch buttons to where they should be in the game. */
+@SuppressLint("ViewConstructor")
+final class ControlEditor extends FrameLayout {
+    private final LauncherConfig config;
+    private final Runnable changed;
+    private final Surface surface;
+    private final LinearLayout panel;
+    private final TextView selectedName;
+    private final Button hide;
+    private String selected;
+
+    ControlEditor(Context context, LauncherConfig config, Runnable changed, Runnable close) {
+        super(context);
+        this.config = config;
+        this.changed = changed;
+        setBackgroundColor(Widgets.BACKGROUND);
+
+        surface = new Surface(context);
+        addView(surface);
+
+        // The middle of the screen is empty in every layout, so the tools sit there.
+        panel = Widgets.card(context);
+        panel.setGravity(Gravity.CENTER_HORIZONTAL);
+        selectedName = Widgets.text(context, "", 14, Widgets.TEXT);
+        selectedName.setGravity(Gravity.CENTER);
+        Widgets.add(panel, selectedName);
+        LinearLayout first = Widgets.row(context);
+        Widgets.add(first, Widgets.button(context, "Kecil −", () -> resize(-0.1f)));
+        Widgets.add(first, Widgets.button(context, "Besar +", () -> resize(0.1f)));
+        hide = Widgets.button(context, "Sembunyikan", this::hideOrRemove);
+        Widgets.add(first, hide);
+        Widgets.add(panel, first);
+        LinearLayout second = Widgets.row(context);
+        Widgets.add(second, Widgets.button(context, "Tambah tombol", this::addButton));
+        Widgets.add(second, Widgets.button(context, "Reset", this::reset));
+        Button done = Widgets.button(context, "Selesai", close);
+        Widgets.highlight(done, true);
+        Widgets.add(second, done);
+        Widgets.add(panel, second);
+        addView(panel, new LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT,
+                Gravity.CENTER));
+        select(null);
+    }
+
+    private void select(String id) {
+        selected = id;
+        LauncherConfig.Spot spot = id == null ? null : config.spots.get(id);
+        if (spot == null) {
+            selected = null;
+            selectedName.setText("Geser tombol untuk memindahkan");
+            hide.setText("Sembunyikan");
+        } else {
+            LauncherConfig.Button button = LauncherConfig.BUTTONS.get(id);
+            selectedName.setText(button.label + "  ·  " + Math.round(spot.scale * 100) + "%");
+            hide.setText(button.optional ? "Lepas dari layar"
+                    : spot.visible ? "Sembunyikan" : "Tampilkan");
+        }
+        surface.invalidate();
+    }
+
+    private void edited() {
+        config.layout = LauncherConfig.LAYOUT_CUSTOM;
+        changed.run();
+        surface.invalidate();
+    }
+
+    private void resize(float step) {
+        LauncherConfig.Spot spot = selected == null ? null : config.spots.get(selected);
+        if (spot != null) {
+            spot.scale = LauncherConfig.clamp(spot.scale + step, 0.5f, 2);
+            edited();
+            select(selected);
+        }
+    }
+
+    private void hideOrRemove() {
+        LauncherConfig.Spot spot = selected == null ? null : config.spots.get(selected);
+        if (spot == null) {
+            return;
+        }
+        if (LauncherConfig.BUTTONS.get(selected).optional) {
+            // Back to its place in the game's "More" or "Extra" grid.
+            config.spots.remove(selected);
+            edited();
+            select(null);
+        } else if (LauncherConfig.canHide(selected)) {
+            spot.visible = !spot.visible;
+            edited();
+            select(selected);
+        } else {
+            selectedName.setText("Tombol ini tidak bisa disembunyikan");
+        }
+    }
+
+    private void addButton() {
+        List<LauncherConfig.Button> missing = config.unplaced();
+        if (missing.isEmpty()) {
+            selectedName.setText("Semua tombol sudah ada di layar");
+            return;
+        }
+        String[] labels = new String[missing.size()];
+        for (int index = 0; index < labels.length; index++) {
+            labels[index] = missing.get(index).label;
+        }
+        new AlertDialog.Builder(getContext())
+                .setTitle("Tambah tombol ke layar")
+                .setItems(labels, (dialog, which) -> {
+                    String id = missing.get(which).id;
+                    config.spots.put(id, new LauncherConfig.Spot('C', 0, 0.2f, 1, true));
+                    edited();
+                    select(id);
+                })
+                .show();
+    }
+
+    private void reset() {
+        config.useMinecraftLayout();
+        changed.run();
+        select(null);
+    }
+
+    /** Draws the buttons as the game will, and handles dragging. */
+    private final class Surface extends View {
+        private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF square = new RectF();
+        private float grabX;
+        private float grabY;
+        private float downX;
+        private float downY;
+        private boolean dragging;
+
+        Surface(Context context) {
+            super(context);
+        }
+
+        private float diameter(String id, LauncherConfig.Spot spot) {
+            return LauncherConfig.BUTTONS.get(id).diameter * spot.scale * getHeight();
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            float width = getWidth();
+            float height = getHeight();
+            // Centre cross for orientation.
+            paint.setStyle(Paint.Style.STROKE);
+            paint.setStrokeWidth(Widgets.dp(getContext(), 1));
+            paint.setColor(Color.argb(40, 255, 255, 255));
+            canvas.drawLine(width / 2, 0, width / 2, height, paint);
+            canvas.drawLine(0, height / 2, width, height / 2, paint);
+
+            for (Map.Entry<String, LauncherConfig.Spot> entry : config.spots.entrySet()) {
+                String id = entry.getKey();
+                LauncherConfig.Spot spot = entry.getValue();
+                if (!LauncherConfig.BUTTONS.containsKey(id)) {
+                    continue;
+                }
+                float x = spot.x(width, height);
+                float y = spot.y(height);
+                float size = diameter(id, spot);
+                boolean chosen = id.equals(selected);
+                if (id.equals("move") && config.dpad) {
+                    float arrow = size * 0.32f;
+                    float offset = size * 0.34f;
+                    drawButton(canvas, x, y - offset, arrow, "▲", chosen, true);
+                    drawButton(canvas, x, y + offset, arrow, "▼", chosen, true);
+                    drawButton(canvas, x - offset, y, arrow, "◀", chosen, true);
+                    drawButton(canvas, x + offset, y, arrow, "▶", chosen, true);
+                } else {
+                    drawButton(canvas, x, y, size, LauncherConfig.BUTTONS.get(id).label,
+                            chosen, spot.visible);
+                }
+            }
+        }
+
+        private void drawButton(Canvas canvas, float x, float y, float size, String label,
+                boolean chosen, boolean visible) {
+            float half = size / 2;
+            square.set(x - half, y - half, x + half, y + half);
+            paint.setStyle(Paint.Style.FILL);
+            int alpha = Math.round((visible ? 200 : 50) * config.opacity);
+            paint.setColor(Color.argb(alpha, 55, 68, 92));
+            canvas.drawRect(square, paint);
+            paint.setStyle(Paint.Style.STROKE);
+            paint.setStrokeWidth(Widgets.dp(getContext(), chosen ? 3 : 1));
+            paint.setColor(chosen ? Color.rgb(120, 230, 140) : Color.argb(90, 255, 255, 255));
+            canvas.drawRect(square, paint);
+            paint.setStyle(Paint.Style.FILL);
+            paint.setColor(Color.argb(visible ? 235 : 100, 255, 255, 255));
+            paint.setTextAlign(Paint.Align.CENTER);
+            float text = Math.min(size * 0.24f, Widgets.dp(getContext(), 14));
+            paint.setTextSize(text);
+            float measured = paint.measureText(label);
+            if (measured > size * 0.92f) {
+                paint.setTextSize(text * size * 0.92f / measured);
+            }
+            canvas.drawText(label, x, y - (paint.ascent() + paint.descent()) / 2, paint);
+        }
+
+        /** The button drawn on top at this point. */
+        private String hit(float x, float y) {
+            String found = null;
+            for (Map.Entry<String, LauncherConfig.Spot> entry : config.spots.entrySet()) {
+                if (!LauncherConfig.BUTTONS.containsKey(entry.getKey())) {
+                    continue;
+                }
+                LauncherConfig.Spot spot = entry.getValue();
+                float half = diameter(entry.getKey(), spot) / 2;
+                if (Math.abs(x - spot.x(getWidth(), getHeight())) <= half
+                        && Math.abs(y - spot.y(getHeight())) <= half) {
+                    found = entry.getKey();
+                }
+            }
+            return found;
+        }
+
+        @Override
+        @SuppressLint("ClickableViewAccessibility")
+        public boolean onTouchEvent(MotionEvent event) {
+            switch (event.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN: {
+                    String id = hit(event.getX(), event.getY());
+                    select(id);
+                    if (id != null) {
+                        LauncherConfig.Spot spot = config.spots.get(id);
+                        grabX = event.getX() - spot.x(getWidth(), getHeight());
+                        grabY = event.getY() - spot.y(getHeight());
+                        downX = event.getX();
+                        downY = event.getY();
+                        dragging = false;
+                    }
+                    return true;
+                }
+                case MotionEvent.ACTION_MOVE: {
+                    LauncherConfig.Spot spot =
+                            selected == null ? null : config.spots.get(selected);
+                    if (spot != null) {
+                        float slop = Widgets.dp(getContext(), 6);
+                        dragging |= Math.hypot(event.getX() - downX, event.getY() - downY) > slop;
+                        if (dragging) {
+                            // Out of the way while dragging.
+                            panel.setVisibility(INVISIBLE);
+                            spot.moveTo(event.getX() - grabX, event.getY() - grabY,
+                                    getWidth(), getHeight());
+                            invalidate();
+                        }
+                    }
+                    return true;
+                }
+                case MotionEvent.ACTION_UP:
+                case MotionEvent.ACTION_CANCEL:
+                    panel.setVisibility(VISIBLE);
+                    if (dragging) {
+                        dragging = false;
+                        edited();
+                    }
+                    return true;
+                default:
+                    return true;
+            }
+        }
+    }
+}
