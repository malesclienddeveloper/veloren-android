index 00000000..b759845a
--- /dev/null
+++ b/android/app/src/main/java/net/veloren/android/ResourcePacks.java
@@ -0,0 +1,271 @@
+package net.veloren.android;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipInputStream;
+
+/**
+ * Resource packs: zip files that mirror the game's assets folder. Each is unpacked to
+ * {@code launcher/packs/<name>}; the enabled ones are merged into
+ * {@code launcher/override}, which the game reads before its own assets.
+ *
+ * <p>The list is ordered by priority: a file in a higher pack wins.
+ */
+final class ResourcePacks {
+    static final class Pack {
+        final String name;
+        boolean enabled;
+
+        Pack(String name, boolean enabled) {
+            this.name = name;
+            this.enabled = enabled;
+        }
+    }
+
+    /** Top folders of the game's assets; a pack must contain at least one. */
+    private static final List<String> ASSET_FOLDERS =
+            Arrays.asList("voxygen", "common", "world", "server");
+    private static final int MAX_ENTRIES = 50_000;
+
+    private final File root;
+    private final File packs;
+    private final long maxBytes;
+
+    ResourcePacks(File launcherDirectory) {
+        this(launcherDirectory, 1024L * 1024 * 1024);
+    }
+
+    ResourcePacks(File launcherDirectory, long maxBytes) {
+        this.root = launcherDirectory;
+        this.packs = new File(launcherDirectory, "packs");
+        this.maxBytes = maxBytes;
+    }
+
+    /** Installed packs, highest priority first. */
+    List<Pack> list() throws IOException {
+        List<Pack> result = new ArrayList<>();
+        List<String> seen = new ArrayList<>();
+        File order = new File(root, "packs.txt");
+        if (order.isFile()) {
+            for (String line : new String(Files.read(order), StandardCharsets.UTF_8)
+                    .split("\n")) {
+                if (line.length() < 3 || line.charAt(1) != '|') {
+                    continue;
+                }
+                String name = line.substring(2);
+                if (name.equals(clean(name)) && new File(packs, name).isDirectory()
+                        && !seen.contains(name)) {
+                    seen.add(name);
+                    result.add(new Pack(name, line.charAt(0) == '1'));
+                }
+            }
+        }
+        return result;
+    }
+
+    private void store(List<Pack> list) throws IOException {
+        StringBuilder text = new StringBuilder();
+        for (Pack pack : list) {
+            text.append(pack.enabled ? '1' : '0').append('|').append(pack.name).append('\n');
+        }
+        Files.writeAtomically(new File(root, "packs.txt"),
+                text.toString().getBytes(StandardCharsets.UTF_8));
+    }
+
+    /** Unpacks a zip as a new, enabled pack with the highest priority. */
+    String importZip(InputStream zip, String suggestedName) throws IOException {
+        File staging = new File(root, "import");
+        Files.delete(staging);
+        Files.makeDirectories(staging);
+        try {
+            unpack(zip, staging);
+            File assets = findAssets(staging);
+            if (assets == null) {
+                throw new IOException("Isi zip bukan resource pack: harus berisi folder "
+                        + "voxygen/, common/, world/ atau server/ (boleh di dalam assets/).");
+            }
+            String base = clean(suggestedName.replaceAll("(?i)\\.zip$", ""));
+            String name = base;
+            for (int copy = 2; new File(packs, name).exists(); copy++) {
+                name = base + " " + copy;
+            }
+            Files.makeDirectories(packs);
+            if (!assets.renameTo(new File(packs, name))) {
+                throw new IOException("Tidak bisa menyimpan resource pack.");
+            }
+            List<Pack> list = list();
+            list.add(0, new Pack(name, true));
+            store(list);
+            return name;
+        } finally {
+            Files.delete(staging);
+        }
+    }
+
+    private void unpack(InputStream zip, File destination) throws IOException {
+        String prefix = destination.getCanonicalPath() + File.separator;
+        long total = 0;
+        int entries = 0;
+        byte[] buffer = new byte[64 * 1024];
+        try (ZipInputStream input = new ZipInputStream(zip)) {
+            ZipEntry entry;
+            while ((entry = input.getNextEntry()) != null) {
+                if (++entries > MAX_ENTRIES) {
+                    throw new IOException("Zip berisi terlalu banyak berkas.");
+                }
+                String path = entry.getName().replace('\\', '/');
+                if (path.startsWith("__MACOSX/")) {
+                    continue;
+                }
+                File target = new File(destination, path);
+                // Refuse names that would land outside the folder ("zip slip").
+                if (path.startsWith("/") || !target.getCanonicalPath().startsWith(prefix)) {
+                    if (entry.isDirectory()
+                            && (target.getCanonicalPath() + File.separator).equals(prefix)) {
+                        continue;
+                    }
+                    throw new IOException("Zip berisi nama berkas yang tidak aman: " + path);
+                }
+                if (entry.isDirectory()) {
+                    Files.makeDirectories(target);
+                    continue;
+                }
+                Files.makeDirectories(target.getParentFile());
+                try (OutputStream output = new FileOutputStream(target)) {
+                    int count;
+                    while ((count = input.read(buffer)) >= 0) {
+                        total += count;
+                        if (total > maxBytes) {
+                            throw new IOException("Resource pack terlalu besar.");
+                        }
+                        output.write(buffer, 0, count);
+                    }
+                }
+            }
+        }
+        if (entries == 0) {
+            throw new IOException("Berkas ini bukan zip atau zip-nya kosong.");
+        }
+    }
+
+    /** The folder inside {@code directory} that corresponds to the game's assets. */
+    private static File findAssets(File directory) {
+        for (int depth = 0; depth < 3; depth++) {
+            File nested = new File(directory, "assets");
+            if (nested.isDirectory() && hasAssetFolder(nested)) {
+                return nested;
+            }
+            if (hasAssetFolder(directory)) {
+                return directory;
+            }
+            // Zips often wrap everything in one folder named after the pack.
+            File[] folders = directory.listFiles(File::isDirectory);
+            if (folders == null || folders.length != 1) {
+                return null;
+            }
+            directory = folders[0];
+        }
+        return null;
+    }
+
+    private static boolean hasAssetFolder(File directory) {
+        for (String folder : ASSET_FOLDERS) {
+            if (new File(directory, folder).isDirectory()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static String clean(String name) {
+        String cleaned = name.replaceAll("[^A-Za-z0-9 ._()-]", "_").trim();
+        if (cleaned.length() > 40) {
+            cleaned = cleaned.substring(0, 40).trim();
+        }
+        return cleaned.isEmpty() || cleaned.startsWith(".") ? "pack" + cleaned : cleaned;
+    }
+
+    void setEnabled(String name, boolean enabled) throws IOException {
+        List<Pack> list = list();
+        for (Pack pack : list) {
+            if (pack.name.equals(name)) {
+                pack.enabled = enabled;
+            }
+        }
+        store(list);
+    }
+
+    /** Moves a pack up ({@code -1}, more priority) or down ({@code 1}). */
+    void move(String name, int direction) throws IOException {
+        List<Pack> list = list();
+        for (int index = 0; index < list.size(); index++) {
+            if (list.get(index).name.equals(name)) {
+                int target = index + direction;
+                if (target >= 0 && target < list.size()) {
+                    Pack pack = list.remove(index);
+                    list.add(target, pack);
+                    store(list);
+                }
+                return;
+            }
+        }
+    }
+
+    void remove(String name) throws IOException {
+        List<Pack> list = list();
+        for (int index = list.size() - 1; index >= 0; index--) {
+            if (list.get(index).name.equals(name)) {
+                list.remove(index);
+                Files.delete(new File(packs, name));
+            }
+        }
+        store(list);
+    }
+
+    /** Rebuilds the folder the game reads from the enabled packs. */
+    void apply() throws IOException {
+        File override = new File(root, "override");
+        File staging = new File(root, "override-staging");
+        Files.delete(staging);
+        List<Pack> list = list();
+        boolean any = false;
+        // Lowest priority first, so that higher packs overwrite it.
+        for (int index = list.size() - 1; index >= 0; index--) {
+            if (list.get(index).enabled) {
+                merge(new File(packs, list.get(index).name), staging);
+                any = true;
+            }
+        }
+        Files.delete(override);
+        if (any && !staging.renameTo(override)) {
+            throw new IOException("Tidak bisa menerapkan resource pack.");
+        }
+    }
+
+    private static void merge(File source, File destination) throws IOException {
+        if (source.isDirectory()) {
+            Files.makeDirectories(destination);
+            File[] children = source.listFiles();
+            if (children == null) {
+                throw new IOException("Tidak bisa membaca " + source.getName());
+            }
+            for (File child : children) {
+                merge(child, new File(destination, child.getName()));
+            }
+            return;
+        }
+        try (InputStream input = new FileInputStream(source);
+                OutputStream output = new FileOutputStream(destination)) {
+            Files.copy(input, output);
+        }
+    }
+}
diff --git a/android/app/src/main/java/net/veloren/android/UpdateDecision.java b/android/app/src/main/java/net/veloren/android/UpdateDecision.java
new file mode 100644
index 00000000..33b60811
--- /dev/null
+++ b/android/app/src/main/java/net/veloren/android/UpdateDecision.java
@@ -0,0 +1,98 @@
+package net.veloren.android;
+
+import java.io.IOException;
+import java.io.StringReader;
+import java.util.Locale;
+import java.util.Properties;
+
+/** Pure update-check logic, kept free of Android classes so it can be tested on any JVM. */
+final class UpdateDecision {
+    enum Status {
+        /** Installed build matches the official weekly release. */
+        UP_TO_DATE,
+        /** A newer APK is published and can be installed over this one. */
+        APK_UPDATE,
+        /** A newer APK is published but signed with a different key. */
+        APK_KEY_MISMATCH,
+        /** The official weekly release moved on, but no APK is published for it yet. */
+        BUILD_PENDING,
+        /** Not enough information to say anything. */
+        CHECK_FAILED
+    }
+
+    /** Contents of the version.properties file attached to a published release. */
+    static final class Release {
+        final long versionCode;
+        final String commit;
+        final String date;
+        final String url;
+        final String sha256;
+        final long size;
+        final String signer;
+
+        private Release(long versionCode, String commit, String date, String url,
+                String sha256, long size, String signer) {
+            this.versionCode = versionCode;
+            this.commit = commit;
+            this.date = date;
+            this.url = url;
+            this.sha256 = sha256;
+            this.size = size;
+            this.signer = signer;
+        }
+
+        /**
+         * Returns null when the text is not a complete release description, or when the
+         * download address is not a release asset of {@code repo}.
+         */
+        static Release parse(String text, String repo) {
+            Properties properties = new Properties();
+            try {
+                properties.load(new StringReader(text));
+                long versionCode = Long.parseLong(value(properties, "versionCode"));
+                long size = Long.parseLong(value(properties, "size"));
+                String commit = value(properties, "commit");
+                String url = value(properties, "url");
+                String sha256 = value(properties, "sha256").toLowerCase(Locale.ROOT);
+                if (versionCode <= 0 || size <= 0 || commit.isEmpty()
+                        || !url.startsWith("https://github.com/" + repo + "/releases/download/")
+                        || !sha256.matches("[0-9a-f]{64}")) {
+                    return null;
+                }
+                return new Release(versionCode, commit, value(properties, "date"), url, sha256,
+                        size, value(properties, "signer").toLowerCase(Locale.ROOT));
+            } catch (IOException | IllegalArgumentException e) {
+                return null;
+            }
+        }
+
+        private static String value(Properties properties, String key) {
+            return properties.getProperty(key, "").trim();
+        }
+    }
+
+    /**
+     * @param installedCode   versionCode of the running APK
+     * @param installedCommit official commit the running APK was built from ("" if unknown)
+     * @param installedSigner SHA-256 of the running APK's signing certificate ("" if unknown)
+     * @param release         newest published APK, or null if it could not be fetched
+     * @param officialCommit  commit of the official weekly tag, or null if it could not be fetched
+     */
+    static Status decide(long installedCode, String installedCommit, String installedSigner,
+            Release release, String officialCommit) {
+        if (release != null && release.versionCode > installedCode) {
+            boolean differentKey = !release.signer.isEmpty() && !installedSigner.isEmpty()
+                    && !release.signer.equalsIgnoreCase(installedSigner);
+            return differentKey ? Status.APK_KEY_MISMATCH : Status.APK_UPDATE;
+        }
+        if (officialCommit == null || officialCommit.isEmpty() || installedCommit.isEmpty()) {
+            return Status.CHECK_FAILED;
+        }
+        return officialCommit.equalsIgnoreCase(installedCommit)
+                ? Status.UP_TO_DATE
+                : Status.BUILD_PENDING;
+    }
+
+    private UpdateDecision() {
+    }
+}
diff --git a/android/app/src/main/java/net/veloren/android/VelorenGameActivity.java b/android/app/src/main/java/net/veloren/android/VelorenGameActivity.java
new file mode 100644
index 00000000..337ae68b
--- /dev/null
+++ b/android/app/src/main/java/net/veloren/android/VelorenGameActivity.java
@@ -0,0 +1,19 @@
+package net.veloren.android;
+
+import android.app.NativeActivity;
+import android.os.Process;
+
+/**
+ * The game itself. It runs in its own process (see the manifest) which is ended together
+ * with the activity: the native event loop cannot be started twice in one process.
+ */
+public class VelorenGameActivity extends NativeActivity {
+    @Override
+    protected void onDestroy() {
+        boolean finishing = isFinishing();
+        super.onDestroy();
+        if (finishing) {
+            Process.killProcess(Process.myPid());
+        }
+    }
+}
diff --git a/android/app/src/main/java/net/veloren/android/Widgets.java b/android/app/src/main/java/net/veloren/android/Widgets.java
new file mode 100644
index 00000000..a0727c97
--- /dev/null
+++ b/android/app/src/main/java/net/veloren/android/Widgets.java
@@ -0,0 +1,103 @@
+package net.veloren.android;
+
+import android.content.Context;
+import android.graphics.Color;
+import android.graphics.drawable.GradientDrawable;
+import android.view.Gravity;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+/** The launcher's look: colours and the few styled views it is made of. */
+final class Widgets {
+    static final int BACKGROUND = Color.rgb(15, 19, 27);
+    static final int SIDEBAR = Color.rgb(22, 28, 39);
+    static final int CARD = Color.rgb(28, 36, 50);
+    static final int BUTTON = Color.rgb(48, 59, 79);
+    static final int ACCENT = Color.rgb(56, 142, 84);
+    static final int TEXT = Color.WHITE;
+    static final int MUTED = Color.rgb(160, 172, 190);
+
+    static int dp(Context context, float value) {
+        return Math.round(value * context.getResources().getDisplayMetrics().density);
+    }
+
+    static GradientDrawable box(Context context, int color) {
+        GradientDrawable shape = new GradientDrawable();
+        shape.setColor(color);
+        shape.setCornerRadius(dp(context, 8));
+        return shape;
+    }
+
+    static TextView text(Context context, String value, int size, int color) {
+        TextView view = new TextView(context);
+        view.setText(value);
+        view.setTextSize(size);
+        view.setTextColor(color);
+        return view;
+    }
+
+    static Button button(Context context, String label, Runnable action) {
+        Button view = new Button(context);
+        view.setText(label);
+        view.setAllCaps(false);
+        view.setTextColor(TEXT);
+        view.setTextSize(14);
+        view.setStateListAnimator(null);
+        view.setMinHeight(0);
+        view.setMinimumHeight(0);
+        view.setMinWidth(0);
+        view.setMinimumWidth(0);
+        view.setGravity(Gravity.CENTER);
+        view.setPadding(dp(context, 14), dp(context, 9), dp(context, 14), dp(context, 9));
+        view.setBackground(box(context, BUTTON));
+        view.setOnClickListener(ignored -> action.run());
+        return view;
+    }
+
+    static void highlight(Button button, boolean selected) {
+        button.setBackground(box(button.getContext(), selected ? ACCENT : BUTTON));
+    }
+
+    static LinearLayout column(Context context) {
+        LinearLayout view = new LinearLayout(context);
+        view.setOrientation(LinearLayout.VERTICAL);
+        return view;
+    }
+
+    static LinearLayout row(Context context) {
+        LinearLayout view = new LinearLayout(context);
+        view.setGravity(Gravity.CENTER_VERTICAL);
+        return view;
+    }
+
+    /** A rounded panel that groups related settings. */
+    static LinearLayout card(Context context) {
+        LinearLayout view = column(context);
+        view.setBackground(box(context, CARD));
+        int padding = dp(context, 14);
+        view.setPadding(padding, padding, padding, padding);
+        return view;
+    }
+
+    /** Adds {@code child} at its natural size with a small gap around it. */
+    static void add(LinearLayout parent, android.view.View child) {
+        LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(
+                LinearLayout.LayoutParams.WRAP_CONTENT, LinearLayout.LayoutParams.WRAP_CONTENT);
+        int gap = dp(parent.getContext(), 4);
+        params.setMargins(gap, gap, gap, gap);
+        parent.addView(child, params);
+    }
+
+    /** Adds {@code child} across the whole width of {@code parent}. */
+    static void addWide(LinearLayout parent, android.view.View child) {
+        LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(
+                LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT);
+        int gap = dp(parent.getContext(), 4);
+        params.setMargins(gap, gap, gap, gap);
+        parent.addView(child, params);
+    }
+
+    private Widgets() {
+    }
+}
