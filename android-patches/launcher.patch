+    private interface PackChange {
+        void run() throws IOException;
+    }
+
+    /** Performs a change and rebuilds the merged folder away from the UI thread. */
+    private void changePacks(PackChange change) {
+        if (packsBusy) {
+            return;
+        }
+        stopCountdown();
+        packsBusy = true;
+        refreshPacks();
+        new Thread(() -> {
+            String problem = null;
+            try {
+                try {
+                    change.run();
+                } finally {
+                    packs.apply();
+                }
+            } catch (IOException | RuntimeException e) {
+                problem = e.getMessage();
+            }
+            final String failed = problem;
+            runOnUiThread(() -> {
+                packsBusy = false;
+                if (!isDestroyed()) {
+                    if (failed != null) {
+                        toast(failed);
+                    }
+                    refreshPacks();
+                }
+            });
+        }, "resource-packs").start();
+    }
+
+    private void pickPack() {
+        Intent pick = new Intent(Intent.ACTION_OPEN_DOCUMENT)
+                .addCategory(Intent.CATEGORY_OPENABLE)
+                .setType("*/*")
+                .putExtra(Intent.EXTRA_MIME_TYPES, new String[] {
+                    "application/zip", "application/x-zip-compressed",
+                    "application/octet-stream"
+                });
+        try {
+            startActivityForResult(pick, PICK_PACK);
+        } catch (ActivityNotFoundException e) {
+            toast("Tidak ada aplikasi pemilih berkas.");
+        }
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode != PICK_PACK || resultCode != RESULT_OK || data == null
+                || data.getData() == null) {
+            return;
+        }
+        Uri uri = data.getData();
+        changePacks(() -> {
+            String name = displayName(uri);
+            try (InputStream input = getContentResolver().openInputStream(uri)) {
+                if (input == null) {
+                    throw new IOException("Berkas tidak bisa dibuka.");
+                }
+                packs.importZip(input, name);
+            }
+        });
+    }
+
+    private String displayName(Uri uri) {
+        try (Cursor cursor = getContentResolver().query(
+                uri, new String[] {OpenableColumns.DISPLAY_NAME}, null, null, null)) {
+            if (cursor != null && cursor.moveToFirst() && cursor.getString(0) != null) {
+                return cursor.getString(0);
+            }
+        }
+        return "pack";
+    }
