@@ -0,0 +1,62 @@
+package net.veloren.android;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+
+/** The few file operations the launcher needs (java.nio.file is newer than minSdk). */
+final class Files {
+    static byte[] read(File file) throws IOException {
+        try (InputStream input = new FileInputStream(file)) {
+            ByteArrayOutputStream output = new ByteArrayOutputStream();
+            copy(input, output);
+            return output.toByteArray();
+        }
+    }
+
+    /** Replaces {@code file} so that readers never see it half written. */
+    static void writeAtomically(File file, byte[] contents) throws IOException {
+        makeDirectories(file.getParentFile());
+        File temporary = new File(file.getPath() + ".tmp");
+        try (FileOutputStream output = new FileOutputStream(temporary)) {
+            output.write(contents);
+            output.getFD().sync();
+        }
+        if (!temporary.renameTo(file)) {
+            throw new IOException("Tidak bisa menyimpan " + file.getName());
+        }
+    }
+
+    static void copy(InputStream input, OutputStream output) throws IOException {
+        byte[] buffer = new byte[64 * 1024];
+        int count;
+        while ((count = input.read(buffer)) >= 0) {
+            output.write(buffer, 0, count);
+        }
+    }
+
+    static void makeDirectories(File directory) throws IOException {
+        if (!directory.isDirectory() && !directory.mkdirs() && !directory.isDirectory()) {
+            throw new IOException("Tidak bisa membuat folder " + directory.getName());
+        }
+    }
+
+    static void delete(File file) throws IOException {
+        File[] children = file.listFiles();
+        if (children != null) {
+            for (File child : children) {
+                delete(child);
+            }
+        }
+        if (file.exists() && !file.delete()) {
+            throw new IOException("Tidak bisa menghapus " + file.getName());
+        }
+    }
+
+    private Files() {
+    }
+}
